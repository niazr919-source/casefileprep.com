# =============================================================================
#  CaseFilePrep - Apache / LiteSpeed configuration for Hostinger shared hosting
#
#  This file is copied into public_html alongside the exported site. It replaces
#  the `headers()` block that Next.js cannot provide in `output: 'export'` mode.
#
#  CANONICAL HOST: www.casefileprep.com
#  If you prefer the bare domain, swap the two redirect blocks in section 2 AND
#  change NEXT_PUBLIC_SITE_URL in .github/workflows/deploy.yml to match. The two
#  must always agree, or canonical tags will point at a URL that redirects.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Directory behaviour
# -----------------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.html

# Next.js exports the not-found page as /404.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------------------------
  # 2. Canonical host and scheme (one redirect hop, never two)
  # ---------------------------------------------------------------------------

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://www.casefileprep.com/$1 [R=301,L]

  # Force www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.casefileprep.com/$1 [R=301,L]

  # --- Bare-domain alternative: comment out the two blocks above, use these ---
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^(.*)$ https://casefileprep.com/$1 [R=301,L]
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ---------------------------------------------------------------------------
  # 3. Clean URLs
  # ---------------------------------------------------------------------------
  # The build uses trailingSlash: true, so every page is <route>/index.html and
  # mod_dir resolves /guides -> /guides/ automatically. We only need to strip a
  # literal ".html" if anyone links to one.
  RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# 4. Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/rss+xml application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# LiteSpeed (Hostinger's server) uses Brotli automatically when available.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# 5. Caching
#    Files under /_next/static carry a content hash in the filename, so they are
#    safe to cache forever. HTML must revalidate or deploys go unnoticed.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 month"
  ExpiresByType image/webp                    "access plus 1 month"
  ExpiresByType image/avif                    "access plus 1 month"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/rss+xml           "access plus 1 hour"
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/plain                    "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Immutable hashed build assets
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: always check for a newer deploy
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ads.txt must be readable and reasonably fresh for Google's crawler
  <Files "ads.txt">
    Header set Cache-Control "public, max-age=3600"
  </Files>

  # ---------------------------------------------------------------------------
  # 6. Security headers (previously in next.config.mjs)
  # ---------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# -----------------------------------------------------------------------------
# 7. MIME types
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType application/rss+xml        .xml
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
  AddType text/plain                 .txt
</IfModule>

# -----------------------------------------------------------------------------
# 8. Block access to files that should never be served
# -----------------------------------------------------------------------------
<FilesMatch "^\.(env|git|npmrc)|\.(map|mdx|ts|tsx)$">
  Require all denied
</FilesMatch>
