# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.casefileprep.com

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
# Leave blank until your AdSense account is approved: slots render as
# labelled, reserved-height placeholders so layout never shifts.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad unit IDs (data-ad-slot values from AdSense / Ad Manager)
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_IN_FEED=

# Google Analytics 4 measurement ID.
# Hard-coded in lib/site.ts by default - this only overrides it. Both the GA4
# ID and the AdSense publisher ID are public identifiers, so they live in the
# repo rather than here: NEXT_PUBLIC_* values are inlined at build time and a
# value set in a hosting panel after the build silently does nothing.
NEXT_PUBLIC_GA4_ID=

# Contact address shown on policy pages
NEXT_PUBLIC_CONTACT_EMAIL=editorial@casefileprep.com
